---
layout: null
collection_name: writing
---
{%- comment -%}
  Atom feed for the writing section, at /writing/feed.xml. Separate from the old blog's /feed.xml
  (made by jekyll-feed from _posts), which this doesn't touch.
{%- endcomment -%}
{%- assign section = site.data.writing -%}
{%- assign posts = site[page.collection_name] | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ section.label | xml_escape }} · Francisca Concha-Ramírez</title>
  <subtitle>{{ section.description | xml_escape }}</subtitle>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ section.url | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ section.url | absolute_url }}</id>
  <updated>{% if posts.size > 0 %}{{ posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>Francisca Concha-Ramírez</name><uri>{{ "/" | absolute_url }}</uri></author>
  {%- for post in posts limit: 20 %}
  <entry>
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {%- endfor %}
    {%- if post.summary %}
    <summary type="html">{{ post.summary | xml_escape }}</summary>
    {%- endif %}
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
